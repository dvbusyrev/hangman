{
  "name": "arctic-life-prototype",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cesium:copy": "node scripts/copy-cesium-assets.mjs",
    "predev": "npm run cesium:copy",
    "dev": "vite",
    "prebuild": "npm run cesium:copy",
    "build": "vite build",
    "preview": "vite preview",
    "postinstall": "npm run cesium:copy",
    "data:osm-boundaries": "node scripts/fetch-osm-boundaries.mjs",
    "data:shapes": "node scripts/export-boundary-shapes.mjs",
    "data:osm-buildings": "node scripts/fetch-osm-buildings.mjs",
    "data:osm": "npm run data:osm-boundaries && npm run data:osm-buildings"
  },
  "dependencies": {
    "cesium": "^1.132.0"
  },
  "devDependencies": {
    "vite": "^7.0.0"
  }
}
